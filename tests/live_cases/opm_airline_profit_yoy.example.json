{
  "name": "opm_airline_profit_yoy",
  "description": "Live E2E: verify OPM airline profit year-over-year report page data matches exported Excel. Replace ${FR_BASE_URL} and ${FR_REPORT_URL} with your OPM environment.",
  "report": {
    "folder": "经营分析",
    "name": "航司净利润同比分析"
  },
  "navigation": {
    "base_url": "${FR_BASE_URL}",
    "report_url": "${FR_REPORT_URL}",
    "login_success_selector": "text=决策平台",
    "filter_selectors": {
      "month": "input[name='month']",
      "market": "select[name='market']"
    }
  },
  "params": {
    "month": "2026-05",
    "market": "ALL"
  },
  "page_extract": {
    "strategy": "network_then_dom",
    "data_api_patterns": ["/decision", "/reportserver", "/view/report"],
    "table_locator": "iframe >> table",
    "visible_row_limit": 20,
    "wait_until": "networkidle"
  },
  "export": {
    "button_text_patterns": ["导出", "Excel", "下载"],
    "format": "xlsx",
    "scope": "current_filter_all_rows",
    "timeout_ms": 60000
  },
  "compare": {
    "mode": "visible_subset_by_key",
    "allow_extra_export_rows": true,
    "key_columns": ["航司", "月份"],
    "value_columns": ["净利润", "同比"],
    "numeric_tolerance": 0.01,
    "percent_tolerance": 0.0001,
    "allow_row_reorder": true
  },
  "expected": {
    "min_page_rows": 1,
    "min_export_rows": 1,
    "must_contain_columns": ["航司", "净利润", "同比"],
    "test_query": "这个月的各航司净利润的同比，谁表现得最差"
  }
}
