{
  "name": "mock_sales_prefix_ordered",
  "description": "页面前20行与Excel前20行一致，Excel有3000行",
  "report": {
    "folder": "mock",
    "name": "Mock Sales Report"
  },
  "navigation": {
    "base_url": "http://127.0.0.1:18080",
    "report_url": "http://127.0.0.1:18080/?scenario=page_20_export_3000_pass"
  },
  "params": {
    "month": "2026-05",
    "market": "ALL"
  },
  "page_extract": {
    "strategy": "dom",
    "table_selector": "#report-table",
    "visible_row_limit": 20
  },
  "export": {
    "url": "http://127.0.0.1:18080/export/?scenario=page_20_export_3000_pass",
    "format": "xlsx",
    "scope": "current_filter_all_rows",
    "timeout_ms": 30000
  },
  "compare": {
    "mode": "visible_prefix_ordered",
    "allow_extra_export_rows": true,
    "value_columns": ["航司", "月份", "净利润", "同比"],
    "ignore_columns": [],
    "numeric_tolerance": 0.01,
    "percent_tolerance": 0.0001,
    "ignore_formatting": true,
    "empty_equivalents": ["", "-", "--", "\u2014", "N/A", null]
  },
  "expected": {
    "min_page_rows": 1,
    "min_export_rows": 20,
    "must_contain_columns": ["航司", "净利润", "同比"]
  }
}
