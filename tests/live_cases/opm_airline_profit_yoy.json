{
  "name": "opm_airline_profit_yoy",
  "description": "Live E2E: OPM 航空集团经营提升分析/1净利润",
  "report": {
    "folder": "航空集团经营提升分析",
    "name": "1净利润"
  },
  "navigation": {
    "report_url": "https://opm.hnair.net/webroot/decision/view/report?viewlet=航空集团经营提升分析/1净利润.cpt",
    "login_success_selector": "text=决策平台"
  },
  "params": {},
  "wait": {
    "max_wait_ms": 90000,
    "poll_interval_ms": 1000,
    "initial_delay_ms": 5000,
    "stable_rounds": 3,
    "min_rows": 1,
    "require_iframe": true,
    "require_table_or_grid": true,
    "loading_selectors": [
      ".loading",
      ".fr-loading",
      ".bi-loading",
      ".x-mask-loading",
      ".spinner",
      "[class*=loading]",
      "[class*=Loading]"
    ],
    "ready_selectors": [
      "iframe",
      "table",
      "[role=grid]",
      ".fr-report",
      ".reportPane"
    ]
  },
  "page_extract": {
    "strategy": "network_then_dom",
    "data_api_patterns": [
      "/decision",
      "/reportserver",
      "/ReportServer",
      "/view/report",
      "/view/form",
      "/fr"
    ],
    "table_selector": "table",
    "visible_row_limit": 20,
    "fallback_recursive_frames": true,
    "save_frame_tree": true,
    "save_network_candidates": true
  },
  "export": {
    "button_text_patterns": ["导出", "Excel", "下载"],
    "format": "xlsx",
    "scope": "current_filter_all_rows",
    "timeout_ms": 90000
  },
  "compare": {
    "mode": "visible_prefix_ordered",
    "allow_extra_export_rows": true,
    "value_columns": [],
    "numeric_tolerance": 0.01,
    "percent_tolerance": 0.0001,
    "allow_row_reorder": true
  },
  "expected": {
    "min_page_rows": 1,
    "min_export_rows": 1,
    "test_query": "净利润"
  }
}
