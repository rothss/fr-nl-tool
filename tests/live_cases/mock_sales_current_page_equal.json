{
  "name": "mock_sales_current_page_equal",
  "description": "当前页导出20行，Excel也为20行，完全一致",
  "report": {
    "folder": "mock",
    "name": "Current Page Report"
  },
  "navigation": {
    "base_url": "http://127.0.0.1:18080",
    "report_url": "http://127.0.0.1:18080/?scenario=current_page_20"
  },
  "params": {
    "month": "2026-05",
    "market": "ALL"
  },
  "page_extract": {
    "strategy": "dom",
    "table_selector": "#report-table",
    "visible_row_limit": 20
  },
  "export": {
    "url": "http://127.0.0.1:18080/export/?scenario=current_page_20",
    "format": "xlsx",
    "scope": "current_page",
    "timeout_ms": 30000
  },
  "compare": {
    "mode": "current_page_equal",
    "allow_extra_export_rows": false,
    "value_columns": ["航司", "月份", "净利润", "同比"],
    "ignore_columns": [],
    "numeric_tolerance": 0.01,
    "percent_tolerance": 0.0001,
    "ignore_formatting": true,
    "empty_equivalents": ["", "-", "--", "\u2014", "N/A", null]
  },
  "expected": {
    "min_page_rows": 20,
    "min_export_rows": 20,
    "must_contain_columns": ["航司", "净利润", "同比"]
  }
}
