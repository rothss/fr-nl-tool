# ===== FineReport Server =====
FR_BASE_URL=http://localhost:8075/webroot/decision
FR_AUTH_TOKEN=

# ===== Browser Automation (CDP) =====
FR_CDP_URL=http://127.0.0.1:9222
FR_BATCH_ROOT=./fr_batch

# ===== Data Mirror =====
FR_DATA_MIRROR_ROOT=./data
FR_MIRROR_ROOT=./fr_mirror
FR_DOM_PROFILE_DIR=./fr_mirror/search_index/dom_profiles
FR_EXCEL_INDEX_DB=./fr_mirror/search_index/excel_index.db
FR_BUILD_INDEX_PY=
FR_EXCEL_INDEX_FALLBACK_DB=
FR_TMP_DIR=./data/tmp

# ===== Optional Live Refresh / External Tools =====
FR_REFRESH_TOOL_ROOT=
FR_EDGE_PROFILE_DIR=./fr_batch/edge_profile_nlquery
FR_FALLBACK_EDGE_PROFILE_DIR=./fr_batch/edge_profile

# ===== Login Detection (pipe-separated patterns) =====
FR_LOGIN_PATTERNS=login_required|unauthorized|请先登录

# ===== Optional Local Intent LLM =====
FR_INTENT_LLM_COMMAND=

# ===== Legacy (for backward compatibility, will be removed) =====
# OPM_BASE_URL, OPM_EDGE_CDP_URL, OPM_BATCH_ROOT, etc.
# FR_BUILD_INDEX_PY can point to an external incremental index builder.
# FR_REFRESH_TOOL_ROOT can point to an external live-refresh downloader.
